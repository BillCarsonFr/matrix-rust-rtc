{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/index.node.ts",
    "src/generated/wasm-bindgen/index.d.ts"
  ]
}
