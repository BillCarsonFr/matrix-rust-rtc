interop/playwright-report/
interop/test-results/
interop/blob-report/

.idea/

mobile/android/.gradle/

# libwebrtc's Java classes for the media AAR. Re-materialized on every
# MEDIA=1 build by scripts/build-android-aar.sh from the SAME libwebrtc
# bundle the native code was linked against — committing it would invite
# version skew between the jar and the .so (runtime JNI breakage).
mobile/android/matrixrtc/libs/

mobile/android/local.properties

mobile/android/build/

mobile/android/matrixrtc/build/

mobile/ios/generated/

# xcframework, headers, zip and checksum from scripts/build-ios-xcframework.sh.
mobile/ios/build/

# Generated Kotlin bindings (org/matrix/rtc/matrix_rtc_ffi.kt); the hand-written
# sources live in src/main/kotlin.
mobile/android/matrixrtc/src/main/java/

# Split debug symbols from scripts/build-android-aar.sh --split-debug.
mobile/android/debuginfo/

# Working copy of scripts/load-test-sample.sh — carries the account password
# and recovery key, so it must never be committed.
scripts/load-test.sh

scripts/load-test-state.sh
